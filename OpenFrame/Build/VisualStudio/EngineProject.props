<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <OutDir>$(MSBuildThisFileDirectory)..\..\..\Artifacts\$(Configuration)\</OutDir>
    <IntDir>$(MSBuildThisFileDirectory)..\..\..\Artifacts\Intermediate\$(Configuration)\$(ProjectName)\</IntDir>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <ClCompile>
      <WarningLevel>Level4</WarningLevel>
      <TreatWarningAsError>true</TreatWarningAsError>
      <TreatAngleIncludeAsExternal>true</TreatAngleIncludeAsExternal>
      <ExternalWarningLevel>TurnOffAllWarnings</ExternalWarningLevel>
      <DisableSpecificWarnings>4251;4275;4458;%(DisableSpecificWarnings)</DisableSpecificWarnings>
      <SDLCheck>true</SDLCheck>
      <ConformanceMode>true</ConformanceMode>
      <LanguageStandard>stdcpp20</LanguageStandard>
      <MultiProcessorCompilation>true</MultiProcessorCompilation>
      <AdditionalOptions>/FS %(AdditionalOptions)</AdditionalOptions>
      <DebugInformationFormat>ProgramDatabase</DebugInformationFormat>
      <AdditionalIncludeDirectories>$(MSBuildThisFileDirectory)..\..\;$(MSBuildThisFileDirectory)..\..\..\ThirdParty\GLFW\include;$(MSBuildThisFileDirectory)..\..\..\ThirdParty\GLEW\include;$(MSBuildThisFileDirectory)..\..\..\ThirdParty\GLM;$(MSBuildThisFileDirectory)..\..\..\ThirdParty\STB;$(MSBuildThisFileDirectory)..\..\..\ThirdParty\ASSIMP\include;$(MSBuildThisFileDirectory)..\..\..\ThirdParty\JSON\single_include;$(MSBuildThisFileDirectory)..\..\..\ThirdParty\ZSTD\lib;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <PreprocessorDefinitions>%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
    <Link>
      <GenerateDebugInformation>true</GenerateDebugInformation>
      <AdditionalLibraryDirectories>$(MSBuildThisFileDirectory)..\..\..\ThirdParty\GLEW\lib\Release\x64;$(MSBuildThisFileDirectory)..\..\..\ThirdParty\GLFW\lib-vc2022;$(MSBuildThisFileDirectory)..\..\..\ThirdParty\ASSIMP\lib;%(AdditionalLibraryDirectories)</AdditionalLibraryDirectories>
      <AdditionalDependencies>%(AdditionalDependencies)</AdditionalDependencies>
      <AdditionalManifestDependencies>type='win32' name='Microsoft.Windows.Common-Controls' version='6.0.0.0' processorArchitecture='*' publicKeyToken='6595b64144ccf1df' language='*';%(AdditionalManifestDependencies)</AdditionalManifestDependencies>
    </Link>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup Condition="'$(Configuration)'=='Release'">
    <ClCompile>
      <FunctionLevelLinking>true</FunctionLevelLinking>
      <IntrinsicFunctions>true</IntrinsicFunctions>
      <RuntimeLibrary>MultiThreadedDLL</RuntimeLibrary>
    </ClCompile>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup Condition="'$(Configuration)'=='Debug'">
    <ClCompile>
      <RuntimeLibrary>MultiThreadedDLL</RuntimeLibrary>
    </ClCompile>
  </ItemDefinitionGroup>
</Project>
