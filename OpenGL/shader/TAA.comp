#version 460 core

layout(local_size_x = 8, local_size_y = 8) in;
layout(binding = 0) uniform sampler2D currentHDR;
layout(binding = 1) uniform sampler2D historyHDR;
layout(binding = 2) uniform sampler2D velocityTexture;
layout(binding = 3) uniform usampler2D currentObjectIDs;
layout(binding = 4) uniform usampler2D historyObjectIDs;
layout(rgba16f, binding = 0) uniform writeonly image2D nextHistory;
layout(rgba16f, binding = 1) uniform writeonly image2D resolvedHDR;
layout(r32ui, binding = 2) uniform writeonly uimage2D nextObjectIDHistory;
uniform uint historyValid;

float luminance(vec3 color)
{
    return dot(color, vec3(0.2126, 0.7152, 0.0722));
}

vec3 rgbToYCoCg(vec3 color)
{
    float co = color.r - color.b;
    float temporary = color.b + co * 0.5;
    float cg = color.g - temporary;
    float y = temporary + cg * 0.5;
    return vec3(y, co, cg);
}

vec3 yCoCgToRgb(vec3 color)
{
    float temporary = color.x - color.z * 0.5;
    float green = color.z + temporary;
    float blue = temporary - color.y * 0.5;
    float red = blue + color.y;
    return vec3(red, green, blue);
}

void main()
{
    ivec2 coordinate = ivec2(gl_GlobalInvocationID.xy);
    ivec2 extent = imageSize(resolvedHDR);
    if (any(greaterThanEqual(coordinate, extent))) return;

    vec4 currentSample = texelFetch(currentHDR, coordinate, 0);
    uint currentObjectID = texelFetch(currentObjectIDs, coordinate, 0).r;
    vec3 current = currentSample.rgb;
    vec3 resolved = current;
    if (historyValid != 0U)
    {
        vec2 velocity = texelFetch(velocityTexture, coordinate, 0).xy * 0.5;
        vec2 uv = (vec2(coordinate) + 0.5) / vec2(extent);
        vec2 historyUv = uv - velocity;
        bool historyInBounds = all(greaterThanEqual(historyUv, vec2(0.0))) && all(lessThanEqual(historyUv, vec2(1.0)));
        vec4 historySample = texture(historyHDR, clamp(historyUv, vec2(0.0), vec2(1.0)));
        uint historyObjectID = texture(historyObjectIDs, clamp(historyUv, vec2(0.0), vec2(1.0))).r;
		bool historySurfaceMatches = historyInBounds && historyObjectID == currentObjectID;

        // Variance clipping in YCoCg retains stable sub-pixel history while
        // rejecting history that no longer belongs to the current surface.
        vec3 neighborhoodMinimum = rgbToYCoCg(current);
        vec3 neighborhoodMaximum = neighborhoodMinimum;
        vec3 neighborhoodMean = vec3(0.0);
        vec3 neighborhoodSecondMoment = vec3(0.0);
        for (int y = -1; y <= 1; ++y)
        {
            for (int x = -1; x <= 1; ++x)
            {
                ivec2 sampleCoordinate = clamp(coordinate + ivec2(x, y), ivec2(0), extent - 1);
                vec3 sampleColor = rgbToYCoCg(texelFetch(currentHDR, sampleCoordinate, 0).rgb);
                neighborhoodMinimum = min(neighborhoodMinimum, sampleColor);
                neighborhoodMaximum = max(neighborhoodMaximum, sampleColor);
                neighborhoodMean += sampleColor;
                neighborhoodSecondMoment += sampleColor * sampleColor;
            }
        }
        neighborhoodMean /= 9.0;
        neighborhoodSecondMoment /= 9.0;
        vec3 standardDeviation = sqrt(max(neighborhoodSecondMoment - neighborhoodMean * neighborhoodMean, vec3(0.0)));
        vec3 varianceMinimum = neighborhoodMean - standardDeviation * 1.25;
        vec3 varianceMaximum = neighborhoodMean + standardDeviation * 1.25;
        vec3 historyYCoCg = clamp(rgbToYCoCg(historySample.rgb), max(neighborhoodMinimum, varianceMinimum),
                                  min(neighborhoodMaximum, varianceMaximum));
        vec3 history = yCoCgToRgb(historyYCoCg);

        float velocityMagnitude = length(velocity * vec2(extent));
        float historyWeight = mix(0.92, 0.08, clamp(velocityMagnitude / 32.0, 0.0, 1.0));
        float colorScale = max(max(luminance(current), luminance(history)), 0.05);
        float lightingDisagreement = abs(luminance(current) - luminance(history)) / colorScale;
        float shadowDisagreement = abs(currentSample.a - historySample.a);
        float reactiveRejection = max(smoothstep(0.05, 0.35, lightingDisagreement),
                                      smoothstep(0.015, 0.20, shadowDisagreement));
		historyWeight *= (1.0 - reactiveRejection) * (historySurfaceMatches ? 1.0 : 0.0);
        resolved = mix(current, history, historyWeight);
    }
    imageStore(nextHistory, coordinate, vec4(resolved, currentSample.a));
    imageStore(resolvedHDR, coordinate, vec4(resolved, currentSample.a));
	imageStore(nextObjectIDHistory, coordinate, uvec4(currentObjectID, 0U, 0U, 0U));
}
